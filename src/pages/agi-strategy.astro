---
import Layout from "../layouts/Layout.astro";

const pillars = [
  {
    label: "Geopolitical Infrastructure",
    role: "Technology Policy Research Intern",
    company: "Hudson Institute",
    dates: "May 2019 – Jul 2019",
    description:
      "Researched how international supply chains, rare earth metals, and semiconductor production govern access to frontier compute. Recognized that AI safety is fundamentally a geopolitical problem: control over compute = control over whose values shape frontier models.",
  },
  {
    label: "Technical Security",
    role: "Machine Learning Intern",
    company: "Draper Laboratory",
    dates: "May 2018 – Aug 2018",
    description:
      "Developed adversarial ML algorithms for a government research project on model security. Demonstrated the concrete threat surface: models are vulnerable to adversarial attacks, poisoning, and misalignment — robustness is a necessary component of safety.",
  },
  {
    label: "User-Facing Harms",
    role: "Product Manager",
    company: "Co-Star Astrology",
    dates: "Nov 2021 – Jan 2026",
    description:
      "Led QA on predictive spiritual models with a focus on protecting users from the psychological harm of unmoderated AI. Learned that even seemingly benign models can cause real damage without careful design, monitoring, and user protection.",
  },
];
---

<Layout
  title="AGI Strategy"
  description="Valentine Wilson — AI safety and AGI strategy, across geopolitics, technical robustness, and user impact."
>
  <section>
    <p class="text-xs font-medium uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
      AGI Strategy
    </p>
    <h1 class="mt-1 text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      Valentine Wilson
    </h1>
    <p class="mt-4 max-w-xl text-neutral-600 dark:text-neutral-400">
      I believe AI safety isn't a single technical problem — it's a set of interlocking failures
      across geopolitics, technical robustness, and human impact. My path hasn't been a straight
      line, but each stop has forced me to confront a different layer of the same challenge: who
      controls compute, whether the systems built on it can be trusted, and what happens to the
      people on the receiving end when they can't be.
    </p>
  </section>

  <section class="mt-12 space-y-10">
    {
      pillars.map((pillar) => (
        <article class="border-l-2 border-neutral-300 pl-5 dark:border-neutral-700">
          <p class="text-xs font-medium uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
            {pillar.label}
          </p>
          <h2 class="mt-1 text-lg font-semibold text-neutral-900 dark:text-neutral-100">
            {pillar.role} · {pillar.company}
          </h2>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">{pillar.dates}</p>
          <p class="mt-3 text-neutral-700 dark:text-neutral-300">{pillar.description}</p>
        </article>
      ))
    }
  </section>

  <section class="mt-12 rounded-lg bg-neutral-100 p-6 dark:bg-neutral-900">
    <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">Integrated View</h2>
    <p class="mt-3 text-neutral-700 dark:text-neutral-300">
      These roles span the three layers of AI safety — geopolitical structures enabling
      development, technical robustness of systems, and lived user experience — showing that
      safety requires thinking across infrastructure, security, and human impact.
    </p>
  </section>

  <section class="mt-12 border-t border-neutral-200 pt-8 dark:border-neutral-800">
    <p class="text-neutral-600 dark:text-neutral-400">
      More on my background: <a href="/experience" class="underline hover:text-neutral-900 dark:hover:text-neutral-100">full experience</a>
      · <a href="/projects" class="underline hover:text-neutral-900 dark:hover:text-neutral-100">projects</a>
    </p>
  </section>
</Layout>

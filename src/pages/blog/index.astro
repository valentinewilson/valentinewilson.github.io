---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog" description="Writing by Valentine Wilson.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">Blog</h1>

  {
    posts.length === 0 ? (
      <p class="mt-6 text-neutral-500 dark:text-neutral-400">No posts yet — check back soon.</p>
    ) : (
      <ul class="mt-8 space-y-8">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block">
              <h2 class="text-lg font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
                {post.data.title}
              </h2>
              <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <p class="mt-1 text-neutral-600 dark:text-neutral-400">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";

const timeline = [
  {
    title: "Product Manager",
    company: "Co-Star Astrology",
    dates: "Nov 2021 – Jan 2026",
    relevant: true,
    teaser:
      "4+ years driving growth, retention, and monetization for a consumer social app. Included QA on predictive models with a deliberate focus on protecting users from the psychological harm of unmoderated AI.",
    subtitle: "Associate Product Manager (Nov 2021 – Apr 2022) → Product Manager (Apr 2022 – Jan 2026)",
    summary:
      "Owned a broad product surface spanning infrastructure, growth, retention, and monetization for a consumer iOS and Android B2C social astrology app.",
    sections: [
      {
        heading: "Company + Product Ops",
        points: [
          "Led product infrastructure and analytics reliability: improved event tracking and resolved gaps in app analytics, driving highly technical projects to ensure accurate reporting and experimentation.",
          "Built and scaled experimentation operations: established A/B testing processes and best practices company-wide, acted as primary point of contact with Firebase for experimentation tooling, and created internal education (seminars) and no-code tools (Google Colab) to enable company-wide test analysis.",
          "Contributed to team growth and hiring, including sourcing and interviewing candidates.",
        ],
      },
      {
        heading: "App Growth + Retention",
        points: [
          "Drove app growth initiatives: onboarding optimization, personalization, and App Store listing optimization.",
          "Owned retention strategy and core engagement features, including push notification permissions and lifecycle strategy, social features (direct messaging, friend graph expansion), and habit-forming experiences (birthday flows, notifications), while accounting for network effects and the risk of splitting interconnected user groups.",
        ],
      },
      {
        heading: "App Monetization",
        points: [
          "Led monetization across one-time purchases and subscriptions, including launching and optimizing seasonal revenue events (e.g. the New Year report drop).",
          "Owned end-to-end purchase funnel optimization (entry points, upsell timing, in-flow conversion) and subscription growth/retention, including free trial strategy, diary study insights, new features, notifications, and shared subscriptions.",
        ],
      },
    ],
  },
  {
    title: "Associate Product Manager (iOS, Android, and Hardware)",
    company: "January AI",
    dates: "Aug 2020 – Aug 2021",
    teaser:
      "Supported the 0→1 launch of a metabolic health app + hardware program in a HIPAA-regulated environment. Built the analytics instrumentation layer from scratch and redesigned onboarding.",
    summary:
      "Supported the 0→1 launch of a B2C metabolic health app + hardware program, driving device integration, growth, and analytics in a HIPAA-regulated environment.",
    sections: [
      {
        heading: "MVP Launch Support",
        points: [
          "Triaged and resolved critical bugs during the 0→1 product launch, ensuring a stable first release.",
          "Managed hardware fulfillment and onboarding logistics, including shipping packages to early customers and coordinating device setup.",
          "Supported early users through live onboarding and customer success.",
        ],
      },
      {
        heading: "Infrastructure & Analytics",
        points: [
          "Built the analytics instrumentation layer from scratch, integrating Amplitude across app and web (210+ events) to support product, growth, and UX teams.",
          "Created a CRM system to track user conversion and embedded behavioral tracking into user research studies.",
        ],
      },
      {
        heading: "Device Integration & Growth",
        points: [
          "Owned data quality and syncing reliability for heart rate monitors and continuous glucose monitors, redesigning screens to improve device onboarding.",
          "Redesigned customer onboarding, cutting session time from 60 → 18 minutes and saving ~$4,000/week, eliminating the need for an additional support hire.",
          "Scrum Master for the App and Web engineering teams: ran Agile, scoped features, and coordinated launches.",
        ],
      },
    ],
  },
  {
    title: "Technology Policy Research Intern",
    company: "Hudson Institute",
    dates: "May 2019 – Jul 2019",
    location: "Washington, D.C.",
    relevant: true,
    teaser:
      "Researched how supply chains and semiconductor policy govern access to frontier compute. This was where I first recognized AI safety as fundamentally a geopolitical problem: control over compute is control over whose values shape frontier models.",
    collapsible: false,
  },
  {
    title: "Student Researcher",
    company: "Emory University, Systems Neural Engineering Lab",
    dates: "Aug 2017 – May 2019",
    teaser:
      "Led development of an ML system linking brain signals to physical movements for neuroscience research, and automated behavioral analysis for the lab.",
    summary:
      "Led development of an ML system linking brain signals to physical movements, and automated behavioral analysis for neuroscience research.",
  },
  {
    title: "Machine Learning Intern",
    company: "Draper Laboratory",
    dates: "May 2018 – Aug 2018",

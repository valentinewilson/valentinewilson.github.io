---

<Layout title="Experience" description="Valentine Wilson's product and technical experience.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    Experience
  </h1>

  <div class="mt-10">
    <Timeline items={timeline} />
  </div>
</Layout>

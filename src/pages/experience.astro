---
import Layout from "../layouts/Layout.astro";

const roles = [
  {
    company: "Co-Star Astrology",
    title: "Product Manager",
    dates: "Nov 2021 – Jan 2026",
    subtitle: "Associate Product Manager (Nov 2021 – Apr 2022) → Product Manager (Apr 2022 – Jan 2026)",
    summary:
      "Owned a broad product surface spanning infrastructure, growth, retention, and monetization for a consumer iOS and Android B2C social astrology app.",
    sections: [
      {
        heading: "Company + Product Ops",
        points: [
          "Led product infrastructure and analytics reliability — improved event tracking and resolved gaps in app analytics, driving highly technical projects to ensure accurate reporting and experimentation.",
          "Built and scaled experimentation operations: established A/B testing processes and best practices company-wide, acted as primary point of contact with Firebase for experimentation tooling, and created internal education (seminars) and no-code tools (Google Colab) to enable company-wide test analysis.",
          "Contributed to team growth and hiring, including sourcing and interviewing candidates.",
        ],
      },
      {
        heading: "App Growth + Retention",
        points: [
          "Drove app growth initiatives: onboarding optimization, personalization, and App Store listing optimization.",
          "Owned retention strategy and core engagement features — push notification permissions and lifecycle strategy, social features (direct messaging, friend graph expansion), and habit-forming experiences (birthday flows, notifications) — while accounting for network effects and the risk of splitting interconnected user groups.",
        ],
      },
      {
        heading: "App Monetization",
        points: [
          "Led monetization across one-time purchases and subscriptions, including launching and optimizing seasonal revenue events (e.g. the New Year report drop).",
          "Owned end-to-end purchase funnel optimization (entry points, upsell timing, in-flow conversion) and subscription growth/retention — free trial strategy, diary study insights, new features, notifications, and shared subscriptions.",
        ],
      },
    ],
  },
  {
    company: "January AI",
    title: "Associate Product Manager",
    dates: "Aug 2020 – Aug 2021",
    subtitle: "iOS, Android, and Hardware",
    summary:
      "Supported the 0→1 launch of a B2C metabolic health app + hardware program, driving device integration, growth, and analytics in a HIPAA-regulated environment.",
    sections: [
      {
        heading: "MVP Launch Support",
        points: [
          "Triaged and resolved critical bugs during the 0→1 product launch, ensuring a stable first release.",
          "Managed hardware fulfillment and onboarding logistics — shipping packages to early customers and coordinating device setup.",
          "Supported early users through live onboarding and customer success.",
        ],
      },
      {
        heading: "Infrastructure & Analytics",
        points: [
          "Built the analytics instrumentation layer from scratch, integrating Amplitude across app and web (210+ events) to support product, growth, and UX teams.",
          "Created a CRM system to track user conversion and embedded behavioral tracking into user research studies.",
        ],
      },
      {
        heading: "Device Integration & Growth",
        points: [
          "Owned data quality and syncing reliability for heart rate monitors and continuous glucose monitors, redesigning screens to improve device onboarding.",
          "Redesigned customer onboarding, cutting session time from 60 → 18 minutes and saving ~$4,000/week — eliminating the need for an additional support hire.",
          "Scrum Master for the App and Web engineering teams — ran Agile, scoped features, and coordinated launches.",
        ],
      },
    ],
  },
];

const earlierRoles = [
  {
    company: "Hudson Institute",
    title: "Technology Policy Research Intern",
    dates: "May 2019 – Jul 2019",
    description:
      "Supported federal trade strategy research on China, semiconductors, and emerging AI capabilities by analyzing rare earth and chip supply chains, technical patents, and U.S.-China trade developments.",
  },
  {
    company: "Emory University, Systems Neural Engineering Lab",
    title: "Student Researcher",
    dates: "Aug 2017 – May 2019",
    description:
      "Led development of an ML system linking brain signals to physical movements, and automated behavioral analysis for neuroscience research.",
  },
  {
    company: "Draper Laboratory",
    title: "Machine Learning Intern",
    dates: "May 2018 – Aug 2018",
    description:
      "Led security testing of internal AI systems using adversarial methods to identify and mitigate risks.",
  },
];
---

<Layout title="Experience" description="Product and technical experience — Valentine Wilson.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    Experience
  </h1>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">
    Product management roles, plus the technical/research work that came before.
  </p>

  <div class="mt-10 space-y-16">
    {
      roles.map((role) => (
        <article>
          <header>
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">{role.company}</h2>
            <p class="text-neutral-700 dark:text-neutral-300">{role.title}</p>
            <p class="mt-0.5 text-sm text-neutral-500 dark:text-neutral-400">{role.dates}</p>
            {role.subtitle && (
              <p class="mt-0.5 text-sm text-neutral-500 dark:text-neutral-400">{role.subtitle}</p>
            )}
          </header>
          <p class="mt-4 text-neutral-700 dark:text-neutral-300">{role.summary}</p>
          <div class="mt-6 space-y-6">
            {role.sections.map((section) => (
              <div>
                <h3 class="font-medium text-neutral-900 dark:text-neutral-100">{section.heading}</h3>
                <ul class="mt-2 list-disc space-y-1.5 pl-5 text-neutral-600 dark:text-neutral-400">
                  {section.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <section class="mt-16 border-t border-neutral-200 pt-10 dark:border-neutral-800">
    <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">Earlier / Research</h2>
    <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
      The technical foundation — ML research and policy work before product management.
    </p>
    <ul class="mt-6 space-y-6">
      {
        earlierRoles.map((role) => (
          <li>
            <p class="font-medium text-neutral-900 dark:text-neutral-100">
              {role.title} · {role.company}
            </p>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">{role.dates}</p>
            <p class="mt-1 text-neutral-600 dark:text-neutral-400">{role.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Home">
  <section class="mb-16">
    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      Hi, I'm Valentine.
    </h1>
    <p class="mt-4 max-w-xl text-neutral-600 dark:text-neutral-400">
      {/* TODO: replace with your real bio */}
      I build things and write about what I learn along the way. This is where I share my
      projects and my writing.
    </p>
    <div class="mt-6 flex gap-4 text-sm">
      <a
        href="/projects"
        class="rounded-md bg-neutral-900 px-4 py-2 font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
      >
        See my projects
      </a>
      <a
        href="/blog"
        class="rounded-md border border-neutral-300 px-4 py-2 font-medium text-neutral-700 transition-colors hover:border-neutral-400 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-600"
      >
        Read the blog
      </a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section>
        <h2 class="mb-4 text-lg font-semibold text-neutral-900 dark:text-neutral-100">
          Recent posts
        </h2>
        <ul class="space-y-4">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="group block">
                <span class="font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
                  {post.data.title}
                </span>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

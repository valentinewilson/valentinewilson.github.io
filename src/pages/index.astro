---
import Layout from "../layouts/Layout.astro";

const interests = [
  "Social media and psychological health",
  "AI's impact on work and labor",
  "Healthy AI-human relationships",
];
---

<Layout title="Home">
  <section>
    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      Hi, I'm Valentine.
    </h1>
    <p class="mt-3 max-w-xl text-neutral-600 dark:text-neutral-400">
      Generalist across UXR, data visualization, product management, engineering, and AI research.
      Started at 17 annotating ML datasets, went on to found a startup and scale products and
      teams over 7+ years.
    </p>

    <div class="mt-8">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
        Most interested in
      </h2>
      <ul class="mt-3 space-y-2">
        {interests.map((item) => (
          <li class="flex gap-2 text-neutral-700 dark:text-neutral-300">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-amber-400" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-8 flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400">
      <span aria-hidden="true">📍</span>
      Based in Philadelphia, looking for my next role. Open to in-person, remote, and hybrid.
    </p>

    <div class="mt-6 flex gap-4 text-sm">
      <a
        href="/experience"
        class="rounded-md bg-neutral-900 px-4 py-2 font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
      >
        See my experience
      </a>
      <a
        href="/projects"
        class="rounded-md border border-neutral-300 px-4 py-2 font-medium text-neutral-700 transition-colors hover:border-neutral-400 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-600"
      >
        See my projects
      </a>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import EntryCard from "../components/EntryCard.astro";

const writingSamples = [
  {
    name: "5G and IoT: Supply Chain Analysis, Security Implications, and Their Impact on US-China Trade",
    dates: "August 2019",
    outlet: "Hudson Institute",
    bullets: [
      "Synthesizes patent filings, breaking news, and legislation into a supply-chain and security analysis of the US-China race for 5G and IoT dominance.",
    ],
    tags: ["National Security", "Tech Policy", "Research Synthesis"],
    link: "/us-china-trade-strategy",
    linkLabel: "Read excerpt",
    note: "Full text available on request",
  },
  {
    name: "The Love Machine (Learning)",
    dates: "July 2019",
    outlet: "TDS Archive (Medium)",
    bullets: [
      "An early exploration of people handing a deeply personal choice, who to date, to an algorithm, drawing on machine learning, survey data, and social psychology.",
    ],
    tags: ["Human-AI Interaction", "Algorithmic Decision-Making"],
    link: "https://medium.com/data-science/the-love-machine-learning-2cfa524a8c78",
    linkLabel: "Read the piece",
  },
];
---

<Layout title="Writing Samples" description="Writing samples by Valentine Wilson.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    Writing Samples
  </h1>

  <section class="mt-10">
    <div class="space-y-4">
      {writingSamples.map((sample) => <EntryCard {...sample} />)}
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import EntryCard from "../components/EntryCard.astro";

const writingSamples = [
  {
    name: "US-China Semiconductor & GPU Trade Strategy",
    dates: "August 2019",
    outlet: "Hudson Institute",
    bullets: [
      "Synthesizes patent filings, breaking news, and legislation into strategic recommendations on US-China semiconductor and GPU trade for the Hudson Institute.",
    ],
    tags: ["National Security", "Tech Policy", "Research Synthesis"],
    noLinkLabel: "Available on request",
  },
  {
    name: "The Love Machine (Learning)",
    dates: "July 2019",
    outlet: "TDS Archive (Medium)",
    bullets: [
      "Synthesizes social psychology research and comparable algorithmic-matching systems to build a compatibility model, then statistically examines how it reshaped the real-world dynamics (geography, bias) that normally govern who forms relationships with whom.",
    ],
    tags: ["Human-AI Interaction", "Algorithmic Decision-Making"],
    link: "https://medium.com/data-science/the-love-machine-learning-2cfa524a8c78",
    linkLabel: "Read the piece",
  },
  {
    name: "The Politics of Romance",
    dates: "May 2020",
    outlet: "The Startup (Medium)",
    bullets: [
      "A self-critical statistical analysis showing how an algorithm designed to expand students' choices instead reinforced political filter bubbles, surfacing the gap between a system's intended and actual effects on autonomy.",
    ],
    tags: ["Algorithmic Bias", "Human Autonomy"],
    link: "https://medium.com/swlh/the-politics-of-romance-fb41dbad5f19",
    linkLabel: "Read the piece",
  },
];
---

<Layout title="Writing Samples" description="Writing samples by Valentine Wilson.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    Writing Samples
  </h1>

  <section class="mt-10">
    <div class="space-y-4">
      {writingSamples.map((sample) => <EntryCard {...sample} />)}
    </div>
  </section>
</Layout>

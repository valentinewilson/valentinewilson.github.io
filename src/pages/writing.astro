---
import Layout from "../layouts/Layout.astro";
import WritingEntry from "../components/WritingEntry.astro";

const writingSamples = [
  {
    name: "US-China Semiconductor & GPU Trade Strategy",
    dates: "August 2019",
    teaser: [
      "Research synthesis for the Hudson Institute on US-China semiconductor and GPU trade strategy.",
      "Pulls together patent filings, breaking news, and legislation to inform policy recommendations.",
    ],
    tags: ["National Security", "Tech Policy", "Research Synthesis"],
  },
  {
    name: "The Love Machine (Learning)",
    dates: "July 2019",
    teaser: [
      "Builds a genetic-algorithm compatibility model for campus matchmaking, grounded in social psychology research and projects like the Stanford Marriage Pact.",
      "Then analyzes the survey data for demographic bias and the propinquity effect — how algorithms can override the geography that normally shapes who we date.",
    ],
    tags: ["Human-AI Interaction", "Algorithmic Decision-Making"],
    link: "https://medium.com/data-science/the-love-machine-learning-2cfa524a8c78",
  },
  {
    name: "The Politics of Romance",
    dates: "May 2020",
    teaser: [
      "Self-critical analysis of The Love Machine's matchmaking data, revealing strong political bias in student dating preferences.",
      "Reflects on how an algorithm meant to broaden students' options instead reinforced their filter bubbles.",
    ],
    tags: ["Algorithmic Bias", "Human Autonomy"],
    link: "https://medium.com/swlh/the-politics-of-romance-fb41dbad5f19",
  },
];
---

<Layout title="Writing Samples" description="Writing samples by Valentine Wilson.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    Writing Samples
  </h1>

  <section class="mt-10">
    <div class="space-y-4">
      {writingSamples.map((sample) => <WritingEntry {...sample} />)}
    </div>
  </section>
</Layout>

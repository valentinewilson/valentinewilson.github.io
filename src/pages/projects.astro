---
import Layout from "../layouts/Layout.astro";
import ProjectEntry from "../components/ProjectEntry.astro";

const press = [
  {
    title: "The Love Machine Learning",
    outlet: "Towards Data Science",
    link: "https://medium.com/data-science/the-love-machine-learning-2cfa524a8c78",
  },
  {
    title: "The Politics of Romance",
    outlet: "The Startup (Medium)",
    link: "https://medium.com/swlh/the-politics-of-romance-fb41dbad5f19",
  },
  {
    title: "Machine Learning Fuels Campus Romance",
    outlet: "Georgia Tech College of Computing",
    link: "https://www.cc.gatech.edu/news/625853/machine-learning-fuels-campus-romance",
  },
  {
    title: "Algorithmic matchmaking: How a group of Georgia Tech students...",
    outlet: "11Alive",
    link: "https://www.11alive.com/video/news/education/algorithmic-matchmaking/85-0ed7e13b-ba6d-45af-8bea-777ff813778f",
  },
  {
    title: "Machine Learning in the Dating World",
    outlet: "Her Campus",
    link: "https://www.hercampus.com/school/ga-tech/machine-learning-dating-world/",
  },
];

const relevantProjects = [
  {
    name: "The Love Machine",
    dates: "Founder · AI + Web · Dec 2018 – Mar 2020",
    teaser:
      "Founded and built an AI-powered matchmaking platform that paired 3,000+ students using a genetic-algorithm compatibility model, scaling to 1,000 users in its first month. It was my first hands-on encounter with the weight of algorithmic influence on real relationships — the design choices behind a compatibility score aren't neutral.",
    description:
      "I designed the 32-question compatibility survey, built the scoring model (combining hard demographic constraints with weighted personality similarity and Likert-scale distance scoring), and led the \"midnight match drop\" launch mechanic — modeled after streetwear drop culture — that drove viral, real-world adoption across campus, culminating in a campus-wide Valentine's Day meetup event.",
  },
  {
    name: "Compliment Machine",
    dates: "Jan 2017",
    teaser:
      "A web app that used Clarifai's vision API and NLTK's sentiment analysis to compliment user photos, winning \"Best Use of Clarifai API\" and the \"Hack Harassment Award\" at SwampHacks. An early example of designing ML-driven interpersonal software with intentional safeguards against harmful use.",
    description:
      "Built at a hackathon focused on combating online harassment — combined computer vision and sentiment analysis to generate genuine, positive feedback on user photos.",
    tags: ["JavaScript", "Clarifai", "NLTK"],
    link: "https://github.com/chsahit/ComplimentMachine",
  },
];

const otherProjects = [
  {
    name: "Exploratory Genetic Data Analysis Tool",
    dates: "Jul 2017",
    teaser: "Explored gene expression data with Institut Pasteur using PCA, t-SNE, and clustering.",
    description:
      "A tool built with Institut Pasteur to explore gene expression data using PCA, t-SNE, Scree Plots, and K-means clustering.",
    tags: ["R", "PCA", "Clustering"],
    link: "https://github.com/vawilson/Exploratory-Genetic-Data-Analysis-Tool",
  },
  {
    name: "Georgia Tech Safewalk App",
    dates: "Sep – Oct 2016",
    teaser: "iOS app that routes pedestrians along the safest path using local crime data.",
    description:
      "An iOS app that processes local crime data alongside Google Maps information to identify the safest walking route between two points on campus.",
    tags: ["iOS"],
  },
  {
    name: "3D Detection of Zebrafish Movement",
    dates: "Sep 2015 – Jun 2016",
    teaser: "Hardware + software system to track zebrafish movement in 3D for a neuroscience research program.",
    description:
      "Built a device to track and store zebrafish movement in 3D space, collaborating with a CS teacher on the tracking software and a biology teacher on habitat design. Used by Sidwell's Molecular Neuroscience class and Biological Research and Investigational Neuroscience Club.",
    tags: ["Hardware", "Computer Vision"],
  },
  {
    name: "Word2vec Analogy Solver",
    dates: "Dec 2016 – May 2017",
    teaser: "Trained a word-embedding model on Wikipedia to attempt to pass the TOEFL.",
    description: "Trained a Word2vec neural word-embedding model on Wikipedia to attempt to pass the TOEFL.",
    tags: ["NLP", "Word2vec"],
  },
  {
    name: "A History of Western Typography",
    dates: "May 2020",
    teaser: "Interactive scrolling visualization on how history shaped typography.",
    description: "An interactive scrolling visualization examining how historical events influenced the development of typography.",
    tags: ["Data Viz", "JavaScript"],
    link: "https://vawilson.github.io/projects/typography_tree_story/",
    githubLink: "https://github.com/vawilson/Typography_Tree",
  },
  {
    name: "Data-Dogism",
    dates: "2019",
    teaser: "Visualizing dog-walking data.",
    description: "Visualizing dog-walking data.",
    tags: ["Python", "Data Viz"],
    link: "https://github.com/vawilson/Data-Dogism",
  },
];
---

<Layout title="Projects" description="Selected projects by Valentine Wilson.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    Projects
  </h1>

  <section class="mt-10">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
      Relevant Projects
    </h2>
    <div class="mt-4 space-y-4">
      {
        relevantProjects.map((project) => (
          <ProjectEntry {...project}>
            {project.name === "The Love Machine" && (
              <div class="mt-4">
                <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100">As seen in:</p>
                <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                  {press.map((item) => (
                    <li>
                      <a href={item.link} class="text-neutral-600 underline hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">
                        {item.outlet}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </ProjectEntry>
        ))
      }
    </div>
  </section>

  <section class="mt-14">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
      Other Projects
    </h2>
    <div class="mt-4 space-y-4">
      {otherProjects.map((project) => <ProjectEntry {...project} />)}
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";

// TODO: replace with your real projects
const projects = [
  {
    name: "Project One",
    description: "A short description of what this project does and why it matters.",
    link: "#",
    tags: ["TypeScript", "React"],
  },
  {
    name: "Project Two",
    description: "A short description of what this project does and why it matters.",
    link: "#",
    tags: ["Python"],
  },
];
---

<Layout title="Projects" description="Selected projects by Valentine Wilson.">
  <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
    Projects
  </h1>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">A few things I've built.</p>

  <ul class="mt-8 space-y-8">
    {
      projects.map((project) => (
        <li class="border-b border-neutral-200 pb-8 dark:border-neutral-800 last:border-0">
          <a href={project.link} class="group">
            <h2 class="text-lg font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
              {project.name}
            </h2>
          </a>
          <p class="mt-1 text-neutral-600 dark:text-neutral-400">{project.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
                {tag}
              </span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</Layout>

---
interface SecondaryLink {
  label: string;
  href: string;
}

interface Props {
  name: string;
  dates: string;
  outlet?: string;
  bullets: string[];
  tags?: string[];
  link?: string;
  linkLabel?: string;
  secondaryLinks?: SecondaryLink[];
  noLinkLabel?: string;
  note?: string;
}

const {
  name,
  dates,
  outlet,
  bullets,
  tags,
  link,
  linkLabel = "View",
  secondaryLinks = [],
  noLinkLabel,
  note,
} = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);
// A whole card can only be a single <a> when there's exactly one destination;
// extra secondary links would otherwise nest an <a> inside an <a>.
const wholeCardClickable = Boolean(link) && secondaryLinks.length === 0;
const Tag = wholeCardClickable ? "a" : "div";
const linkProps = wholeCardClickable
  ? { href: link, ...(isExternal(link!) ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    "group block rounded-lg border p-5 transition-colors",
    wholeCardClickable
      ? "border-neutral-200 hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
      : link
        ? "border-neutral-200 dark:border-neutral-800"
        : "border-dashed border-neutral-200 dark:border-neutral-800",
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">{name}</h3>
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          {outlet && <>{outlet} · </>}
          {dates}
        </p>
        {tags && tags.length > 0 && (
          <>
            <span class="h-3.5 w-px bg-neutral-300 dark:bg-neutral-700" aria-hidden="true" />
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
    {wholeCardClickable && (
      <span
        class="mt-1 shrink-0 text-neutral-400 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-neutral-900 dark:group-hover:text-neutral-100"
        aria-hidden="true"
      >
        ↗
      </span>
    )}
  </div>

  {
    bullets.length === 1 ? (
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">{bullets[0]}</p>
    ) : (
      <ul class="mt-3 list-disc space-y-1 pl-5 text-neutral-600 dark:text-neutral-400">
        {bullets.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    )
  }

  {
    link ? (
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
        {wholeCardClickable ? (
          <span class="inline-flex items-center gap-1 text-sm font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
            {linkLabel} <span aria-hidden="true">→</span>
          </span>
        ) : (
          <a
            href={link}
            target={isExternal(link) ? "_blank" : undefined}
            rel={isExternal(link) ? "noopener noreferrer" : undefined}
            class="text-sm font-medium text-neutral-900 hover:underline dark:text-neutral-100"
          >
            {linkLabel}
          </a>
        )}
        {secondaryLinks.length > 0 && (
          <>
            <span class="h-3.5 w-px bg-neutral-300 dark:bg-neutral-700" aria-hidden="true" />
            {secondaryLinks.map((l) => (
              <a
                href={l.href}
                target={isExternal(l.href) ? "_blank" : undefined}
                rel={isExternal(l.href) ? "noopener noreferrer" : undefined}
                class="text-sm font-medium text-neutral-900 hover:underline dark:text-neutral-100"
              >
                {l.label}
              </a>
            ))}
          </>
        )}
      </div>
    ) : (
      noLinkLabel && (
        <span class="mt-4 inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
          {noLinkLabel}
        </span>
      )
    )
  }

  {
    note && (
      <span class="mt-3 inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
        {note}
      </span>
    )
  }
</Tag>

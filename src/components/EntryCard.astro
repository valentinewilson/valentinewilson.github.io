---
interface Props {
  name: string;
  dates: string;
  outlet?: string;
  bullets: string[];
  tags?: string[];
  link?: string;
  linkLabel?: string;
  noLinkLabel?: string;
}

const { name, dates, outlet, bullets, tags, link, linkLabel = "View", noLinkLabel } = Astro.props;
const Tag = link ? "a" : "div";
const isExternal = link ? /^https?:\/\//.test(link) : false;
const linkProps = link ? { href: link, ...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}) } : {};
---

<Tag
  {...linkProps}
  class:list={[
    "group block rounded-lg border p-5 transition-colors",
    link
      ? "border-neutral-200 hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
      : "border-dashed border-neutral-200 dark:border-neutral-800",
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">{name}</h3>
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          {outlet && <>{outlet} · </>}
          {dates}
        </p>
        {tags && tags.length > 0 && (
          <>
            <span class="h-3.5 w-px bg-neutral-300 dark:bg-neutral-700" aria-hidden="true" />
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
    {link && (
      <span
        class="mt-1 shrink-0 text-neutral-400 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-neutral-900 dark:group-hover:text-neutral-100"
        aria-hidden="true"
      >
        ↗
      </span>
    )}
  </div>

  <ul class="mt-3 list-disc space-y-1 pl-5 text-neutral-600 dark:text-neutral-400">
    {bullets.map((line) => (
      <li>{line}</li>
    ))}
  </ul>

  {
    link ? (
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
        {linkLabel} <span aria-hidden="true">→</span>
      </span>
    ) : (
      noLinkLabel && (
        <span class="mt-4 inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
          {noLinkLabel}
        </span>
      )
    )
  }
</Tag>

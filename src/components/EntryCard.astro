---
interface LinkItem {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  name: string;
  dates: string;
  outlet?: string;
  bullets: string[];
  tags?: string[];
  links?: LinkItem[];
  noLinkLabel?: string;
}

const { name, dates, outlet, bullets, tags, links = [], noLinkLabel } = Astro.props;
const hasSlot = Astro.slots.has("default");
const clickable = links.length === 1 && !hasSlot;
const single = clickable ? links[0] : undefined;
const Tag = clickable ? "a" : "div";
const isExternal = (href: string) => /^https?:\/\//.test(href);
const linkProps = clickable
  ? { href: single!.href, ...(isExternal(single!.href) ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    "group block rounded-lg border p-5 transition-colors",
    clickable
      ? "border-neutral-200 hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
      : links.length === 0
        ? "border-dashed border-neutral-200 dark:border-neutral-800"
        : "border-neutral-200 dark:border-neutral-800",
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">{name}</h3>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        {outlet && <>{outlet} · </>}
        {dates}
        {tags && tags.length > 0 && <> · {tags.join(" · ")}</>}
      </p>
    </div>
    {clickable && (
      <span
        class="mt-1 shrink-0 text-neutral-400 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-neutral-900 dark:group-hover:text-neutral-100"
        aria-hidden="true"
      >
        ↗
      </span>
    )}
  </div>

  <ul class="mt-3 list-disc space-y-1 pl-5 text-neutral-600 dark:text-neutral-400">
    {bullets.map((line) => (
      <li>{line}</li>
    ))}
  </ul>

  {
    clickable ? (
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
        {single!.label} <span aria-hidden="true">→</span>
      </span>
    ) : links.length > 0 ? (
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {links.map((l) => (
          <a
            href={l.href}
            target={isExternal(l.href) ? "_blank" : undefined}
            rel={isExternal(l.href) ? "noopener noreferrer" : undefined}
            class:list={[
              "inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-xs font-medium transition-colors",
              l.primary
                ? "bg-neutral-900 text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
                : "border border-neutral-300 text-neutral-700 hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-600 dark:hover:bg-neutral-900",
            ]}
          >
            {l.label}
            {!l.primary && <span aria-hidden="true"> ↗</span>}
          </a>
        ))}
      </div>
    ) : (
      noLinkLabel && (
        <span class="mt-4 inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
          {noLinkLabel}
        </span>
      )
    )
  }

  <slot />
</Tag>

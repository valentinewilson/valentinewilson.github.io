---
interface Props {
  name: string;
  dates: string;
  teaser?: string;
  description?: string;
  tags?: string[];
  siteLink?: string;
  githubLink?: string;
  caseStudyLink?: string;
  collapsible?: boolean;
}

const { name, dates, teaser, description, tags, siteLink, githubLink, caseStudyLink, collapsible = true } = Astro.props;
---

{
  collapsible ? (
    <details class="group border-b border-neutral-200 pb-4 dark:border-neutral-800">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-2 [&::-webkit-details-marker]:hidden">
        <div>
          <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">{name}</h3>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">{dates}</p>
          <p class="mt-1 text-neutral-600 dark:text-neutral-400">{teaser}</p>
        </div>
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-neutral-300 text-neutral-500 transition-transform group-open:rotate-180 dark:border-neutral-700 dark:text-neutral-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <div class="mt-3">
        {description && <p class="text-neutral-600 dark:text-neutral-400">{description}</p>}
        <div class="mt-3 flex flex-wrap items-center gap-2">
          {tags && tags.map((tag) => (
            <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
              {tag}
            </span>
          ))}
          {caseStudyLink && (
            <a
              href={caseStudyLink}
              class="inline-flex items-center gap-1 rounded-md bg-neutral-900 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
            >
              Case Study
            </a>
          )}
          {siteLink && (
            <a
              href={siteLink}
              class="inline-flex items-center gap-1 rounded-md border border-neutral-300 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
            >
              Link <span aria-hidden="true">↗</span>
            </a>
          )}
          {githubLink && (
            <a
              href={githubLink}
              class="inline-flex items-center gap-1 rounded-md border border-neutral-300 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
            >
              GitHub <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
        <slot />
      </div>
    </details>
  ) : (
    <div class="border-b border-neutral-200 pb-4 dark:border-neutral-800">
      <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">{name}</h3>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">{dates}</p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        {tags && tags.map((tag) => (
          <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
            {tag}
          </span>
        ))}
        {caseStudyLink && (
          <a
            href={caseStudyLink}
            class="inline-flex items-center gap-1 rounded-md bg-neutral-900 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
          >
            Case Study
          </a>
        )}
        {siteLink && (
          <a
            href={siteLink}
            class="inline-flex items-center gap-1 rounded-md border border-neutral-300 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
          >
            Link <span aria-hidden="true">↗</span>
          </a>
        )}
        {githubLink && (
          <a
            href={githubLink}
            class="inline-flex items-center gap-1 rounded-md border border-neutral-300 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:border-neutral-400 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-600 dark:hover:bg-neutral-900"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">{description ?? teaser}</p>
      <slot />
    </div>
  )
}

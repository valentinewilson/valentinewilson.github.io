---
interface Props {
  name: string;
  dates: string;
  teaser: string;
  description?: string;
  tags?: string[];
  link?: string;
  githubLink?: string;
}

const { name, dates, teaser, description, tags, link, githubLink } = Astro.props;
---

<details class="group border-b border-neutral-200 pb-4 dark:border-neutral-800">
  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-2 [&::-webkit-details-marker]:hidden">
    <div>
      <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">{name}</h3>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">{dates}</p>
      <p class="mt-1 text-neutral-600 dark:text-neutral-400">{teaser}</p>
    </div>
    <svg
      class="mt-1 h-4 w-4 shrink-0 text-neutral-400 transition-transform group-open:rotate-180"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>
  <div class="mt-3">
    {description && <p class="text-neutral-600 dark:text-neutral-400">{description}</p>}
    <div class="mt-3 flex flex-wrap items-center gap-2">
      {tags && tags.map((tag) => (
        <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
          {tag}
        </span>
      ))}
      {link && (
        <a href={link} class="text-xs text-neutral-500 underline hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">
          View
        </a>
      )}
      {githubLink && (
        <a href={githubLink} class="text-xs text-neutral-500 underline hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">
          Source
        </a>
      )}
    </div>
    <slot />
  </div>
</details>

---
interface Section {
  heading: string;
  points: string[];
}

interface TimelineItem {
  title: string;
  company: string;
  dates: string;
  location?: string;
  teaser: string;
  relevant?: boolean;
  subtitle?: string;
  summary?: string;
  sections?: Section[];
  collapsible?: boolean;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="relative space-y-6 border-l-2 border-neutral-200 pl-6 dark:border-neutral-800">
  {
    items.map((item) => {
      const collapsible = item.collapsible ?? true;
      const hasBody = Boolean(item.subtitle || item.summary || (item.sections && item.sections.length > 0));
      const header = (
        <div class="flex items-center gap-2">
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
            {item.title} · {item.company}
          </h3>
          {item.relevant && (
            <svg class="h-4 w-4 shrink-0 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-label="Relevant">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 0 0 .95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 0 0-.363 1.118l1.287 3.957c.3.922-.755 1.688-1.538 1.118l-3.367-2.446a1 1 0 0 0-1.176 0l-3.367 2.446c-.783.57-1.838-.196-1.538-1.118l1.287-3.957a1 1 0 0 0-.363-1.118L2.064 9.385c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 0 0 .95-.69l1.284-3.958z" />
            </svg>
          )}
        </div>
      );
      const dateLine = (
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          {item.dates}
          {item.location && ` · ${item.location}`}
        </p>
      );
      const body = (
        <div class="mt-3">
          {item.subtitle && <p class="text-sm text-neutral-500 dark:text-neutral-400">{item.subtitle}</p>}
          {item.summary && <p class="mt-2 text-neutral-700 dark:text-neutral-300">{item.summary}</p>}
          {item.sections && item.sections.length > 0 && (
            <div class="mt-5 space-y-5">
              {item.sections.map((section) => (
                <div>
                  <h4 class="font-medium text-neutral-900 dark:text-neutral-100">{section.heading}</h4>
                  <ul class="mt-2 list-disc space-y-1.5 pl-5 text-neutral-600 dark:text-neutral-400">
                    {section.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      );

      return (
        <li class="relative">
          <span class="absolute -left-[27px] top-3 h-3 w-3 rounded-full bg-neutral-300 dark:bg-neutral-700" />
          {collapsible && hasBody ? (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-2 [&::-webkit-details-marker]:hidden">
                <div>
                  {header}
                  {dateLine}
                  <p class="mt-1 text-neutral-600 dark:text-neutral-400">{item.teaser}</p>
                </div>
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-neutral-300 text-neutral-500 transition-transform group-open:rotate-180 dark:border-neutral-700 dark:text-neutral-400">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              {body}
            </details>
          ) : (
            <div class="py-2">
              {header}
              {dateLine}
              <p class="mt-1 text-neutral-600 dark:text-neutral-400">{item.teaser}</p>
            </div>
          )}
        </li>
      );
    })
  }
</ol>
